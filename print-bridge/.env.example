# Copy this file to .env and fill in your printer's details.
# .env is gitignored — never commit real tokens or internal IPs.

# Port this bridge listens on for connections from the Staff Hub.
BRIDGE_PORT=9001

# A shared secret the Staff Hub must send with every print job. Set
# this to something random once you're actually using this on a real
# network; leave blank only while testing on a trusted local network.
BRIDGE_TOKEN=

# 'lan' (works today) or 'usb' (not implemented yet, see transport.js)
PRINTER_TRANSPORT=lan

# Your printer's IP address on the local network (LAN transport only).
PRINTER_HOST=

# Almost all network ESC/POS printers use this port. Rarely needs
# changing.
PRINTER_PORT=9100

# 32 for a narrow 58mm printer, 42 for a standard 80mm printer.
RECEIPT_WIDTH=32
