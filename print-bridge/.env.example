# Copy this file to .env and fill in your printer's details.
# .env is gitignored — never commit real tokens or internal IPs.

# The same random string you set with `select set_print_bridge_token('...')`
# in the Supabase SQL Editor (as an admin). Required — every print job
# check is rejected without it. See the SETUP comment at the top of
# index.js.
BRIDGE_TOKEN=

# 'lan' (works today) or 'usb' (not implemented yet, see transport.js)
PRINTER_TRANSPORT=lan

# Your printer's IP address on the local network (LAN transport only).
# Give it a static/reserved IP in your router so this never changes.
PRINTER_HOST=

# Almost all network ESC/POS printers use this port. Rarely needs
# changing.
PRINTER_PORT=9100

# 42 for a standard 80mm printer (the default — matches the Epson
# TM-m30III), 32 for a narrow 58mm printer.
RECEIPT_WIDTH=42

# How often to check Supabase for new print jobs, in milliseconds.
POLL_INTERVAL_MS=4000

# Only need to change these if you've pointed this project at a
# different Supabase project than the one already live — same values as
# order/supabase-config.js.
SUPABASE_URL=
SUPABASE_ANON_KEY=
